---
import '@fontsource-variable/newsreader';
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/be-vietnam-pro/600.css';
import '../styles/theme.css';
import AuthNav from '../components/AuthNav';

interface Props { title: string; description?: string; noindex?: boolean }
const {
  title,
  description = 'EpiSense: giám sát nhiệt độ và độ ẩm theo thời gian thực, cảnh báo khi vượt ngưỡng',
  noindex = false,
} = Astro.props;
const nav = [
  { href: '/', label: 'Trang chủ' },
  { href: '/dashboard/', label: 'Dashboard' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eaf1f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1226" media="(prefers-color-scheme: dark)" />
    <title>{title} | EpiSense</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Bỏ qua phần điều hướng</a>
    <header class="site-header">
      <a class="brand" href="/">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path d="M4 15h4l2-7 3 9 2-6h5" fill="none" stroke="var(--eosin)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        EpiSense
      </a>
      <nav class="site-nav" aria-label="Chính">
        {nav.map((i) => (
          <a href={i.href} aria-current={path === i.href ? 'page' : undefined}>{i.label}</a>
        ))}
      </nav>
      <div class="auth-slot"><AuthNav client:load /></div>
    </header>
    <main id="main" class="page"><slot /></main>
    <footer class="site-footer">EpiSense, dự án giám sát môi trường bằng ESP32 và MQTT. © {new Date().getFullYear()}</footer>
  </body>
</html>